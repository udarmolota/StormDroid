# Release signing. Copy to keystore.properties (same folder, never committed) and fill in.
# Without keystore.properties a release build is signed with the debug key.
# Use forward slashes in the path: a backslash is an escape character in this file.
storeFile=C:/path/to/release-key.p12
storePassword=
keyAlias=
keyPassword=
# Optional: pkcs12 or jks. A .p12 file is taken as pkcs12 without it.
#storeType=pkcs12
