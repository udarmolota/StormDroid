<?xml version="1.0" encoding="utf-8"?>
<!-- Download the game (DownloadFragment): from Steam (the Game tab) or from GOG (its own drawer item,
     argument source = gog): the login, then progress, a small console log, and Create instance once the
     archive is in /Download/StormDroid. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Steam (the Game tab) -->
        <LinearLayout
            android:id="@+id/section_steam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/download_game_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/download_login_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/download_user_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dl_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/download_pass_hint"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dl_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/download_manifest_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dl_manifest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dl_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_start" />

        <!-- DLCs: Against the Storm's DLC content is in the game already; this signs in and records
             which DLCs the account owns, so the game unlocks them (SteamDownloader.forDlcCheck). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dl_check_dlc"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_check_dlc" />

        <TextView
            android:id="@+id/tv_dl_dlcs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_dl"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:max="100"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/section_gog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- GOG: sign in to GOG, then download the Windows build through GOG Galaxy's content system
             (GogGalaxyDownloader). Shares the console, progress and Create instance with Steam. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/gog_download_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tv_gog_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/gog_product_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_gog_product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_gog_sign_in"
                style="@style/AppTheme.TransferButton.Outlined"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="8dp"
                android:text="@string/gog_sign_in" />

            <Button
                android:id="@+id/btn_gog_download"
                style="@style/AppTheme.TransferButton"
                android:layout_marginEnd="0dp"
                android:layout_marginStart="8dp"
                android:text="@string/gog_download" />
        </LinearLayout>

        </LinearLayout>

        <!-- Compact scrolling console (auto-scrolls to the newest line). -->
        <TextView
            android:id="@+id/tv_dl_status"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:background="#14000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dl_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_cancel"
            android:visibility="gone" />

        <!-- Opens Add instance with the downloaded archive already chosen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dl_create_instance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:icon="@drawable/mt_icon_add" />
    </LinearLayout>
</ScrollView>
