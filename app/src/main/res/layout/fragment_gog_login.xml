<?xml version="1.0" encoding="utf-8"?>
<!-- GOG sign-in (GogLoginFragment): GOG's own login page, then a status line while the code is exchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_gog_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/gog_login_note"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <ProgressBar
        android:id="@+id/progress_gog"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <WebView
        android:id="@+id/web_gog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
