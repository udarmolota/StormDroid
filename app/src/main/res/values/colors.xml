         sky and fog) as the main colour, the RED-BROWN of the trees and soil as the accent. Light mode
         uses a deeper blue so text and icons stay readable on light surfaces. -->
    <color name="rd_primary">#4E5BA6</color>
    <color name="rd_primary_dark">#36428D</color>
    <color name="rd_primary_container">#DDE1FF</color>
    <color name="rd_on_primary_container">#0A154F</color>
    <color name="rd_secondary">#8E3F2F</color>
    <!-- launcher icon background (ic_launcher_background), the same in both modes -->
    <color name="ic_launcher_bg">#1C2140</color>

