    <string name="render_res_label">Render resolution</string>
    <string name="render_res_fullscreen">fullscreen</string>
    <string name="render_res_black_margins">black margins</string>
    <string name="render_res_hint">Lower = more FPS on weak GPUs. Native = sharpest. The game\'s interface keeps its size; change it in the game\'s own video options (UI size).</string>
